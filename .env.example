# ==========================================
# S. TEJASWINI PORTFOLIO ENVIRONMENT CONFIG
# ==========================================

# 1. Google Gemini API Key (Serverless / Vercel Backend)
# Obtain from: https://aistudio.google.com/app/apikey
# In Vercel, add this under Settings -> Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# 2. EmailJS Credentials (Contact Form)
# Obtain from: https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
